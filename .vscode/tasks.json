{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: gcc src",
            "command": "/usr/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-I",
                "${workspaceFolder}/include", // 添加 include 目录
                "-g",
                "${fileDirname}/*.c",
                "-o",
                // "${fileDirname}/${fileBasenameNoExtension}"
                "${workspaceFolder}/build/main",
                "$(pkg-config",               // 添加 GTK 库
                "--cflags",
                "--libs",
                "gtk+-3.0)",
                "-lm"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "调试器生成的任务。"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc test",
            "command": "/usr/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-I",
                "${workspaceFolder}/include", // 添加 include 目录
                "-g",
                "${file}",
                "-o",
                // "${fileDirname}/${fileBasenameNoExtension}"
                "${workspaceFolder}/test/${fileBasenameNoExtension}",
                "$(pkg-config",               // 添加 GTK 库
                "--cflags",
                "--libs",
                "gtk+-3.0)",
                "-lm"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "调试器生成的任务。"
        }
    ],
    "version": "2.0.0"
}